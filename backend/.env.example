PORT=5000
MONGO_URI=
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app
# Tenant guard mode: enforce (default in production/tests), warn (default in dev), or off
TENANT_GUARD=warn
# Optional DNS override: true to force 1.1.1.1 / 8.8.8.8 public DNS resolvers (default false)
USE_PUBLIC_DNS=false
# AI embeddings & Smart Search
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
DAILY_AI_BUDGET=500
